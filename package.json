{
  "name": "e-sante",
  "private": true,
  "scripts": {
    "dev": "./node_modules/.bin/turbo run dev",
    "build": "./node_modules/.bin/turbo run build",
    "db:generate": "pnpm --filter @e-sante/db exec prisma generate",
    "db:push": "pnpm --filter @e-sante/db db:push"
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ],
    "allowBuilds": {
      "@nestjs/core": true,
      "@prisma/client": true,
      "@prisma/engines": true,
      "prisma": true,
      "esbuild": true,
      "unrs-resolver": true
    }
  }
}